# Copy this file to .env and fill every blank required value.
# The installer copies the result to /etc/aza-vpn/aza-vpn.env with mode 0600.

# Public IPv4 (or a DNS name) used by clients to reach this VPS.
AZA_SERVER_ADDRESS=

# Friendly label used only in CLI output and URI fragments.
AZA_SERVER_LABEL=Germany-01

# Unoccupied non-privileged TCP port. TCP 443 is intentionally not the default.
AZA_VLESS_PORT=
AZA_LISTEN_ADDRESS=0.0.0.0

# REALITY target selected and tested from the VPS. Include the target TCP port.
REALITY_SERVER_NAME=
REALITY_DEST=
REALITY_FINGERPRINT=chrome

# "latest" resolves through the official GitHub releases/latest API and the
# resolved tag is recorded. A pin may be written as vX.Y.Z or X.Y.Z.
XRAY_VERSION=latest
XRAY_LOG_LEVEL=warning

